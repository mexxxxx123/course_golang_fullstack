package components

type InputData struct {
	Name        string
	Placeholder string
	Type        string
}

templ Input(props InputData) {
	@InputStyle()
	<input class="input" name={ props.Name } placeholder={ props.Placeholder } type={ props.Type }/>
}

templ InputStyle() {
	<style>
        
.input{
	font-weight: 400;
	font-size: 16px;
	width: 100%;
	border: none;
    border-radius: 20px;
	height: 80px;
	padding: 20px ;
	color: #808080;
	background: #fff;
    }
    </style>
}
