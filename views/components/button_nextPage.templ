

package components

templ ButtonNextPage(text string) {
	@ButtonNextPageStyle()
	<div class="ButtonNextPage">
		<button class="ButtonText">{ text }</button>
	</div>
}

templ ButtonNextPageStyle() {
	<style>

.ButtonNextPage{
            display: inline-flex;
            align-items: center;
            gap: 5px;
            text-decoration: none;
}
        
.ButtonText{
	background: none;
    text-decoration: none;
	font-style: normal;
	border: none;
    font-weight: 500;
    font-size: 20px;
    line-height: 115%;
    color: #6c757d;
}
    </style>
}
