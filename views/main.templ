package views

import "mexxx1/golang-fullstack/views/components"
import "mexxx1/golang-fullstack/views/layout"
import "mexxx1/golang-fullstack/views/widgets"
import "time"

templ Main() {
	@MainStyle()
	@layout.Layout(layout.LayoutProps{
		Title:           "Найди работу мечты",
		MetaDescription: "Сайт по поиску работы мечты",
	}) {
		<main>
			@layout.Header() {
				@components.Title("Найди работу своей мечты !")
				@components.SubTitle("Простой поиск работы")
			}
			@widgets.VacancyForm()
			@widgets.VacancyCard(widgets.VacancyCardProps{
				Role:        "Директор по продажам",
				Location:    "Москва",
				Salary:      "200 000 руб",
				CompanyType: "Медиа",
				CompanyName: "ООО Василий",
				Email:       "",
				Createdat:   time.Now(),
			})
		</main>
	}
}

templ MainStyle() {
	<style>
	.body{
		box-sizing: border-box;
	}				
	</style>
}
