
package views

import "mexxx1/golang-fullstack/views/layout"
import "mexxx1/golang-fullstack/views/components"

templ Login() {
	@LoginStyle()
	@layout.Layout(layout.LayoutProps{
		Title:           "Войти на сайт",
		MetaDescription: "Страница входа на сайт вакансий",
	}) {
		<main>
			@layout.Header() {
				@components.Title("Войти на сайт")
				@components.SubTitle("Войдите под своей учётной записью")
			}
		</main>
	}
}

templ LoginStyle() {
	<style>
	.body{
		box-sizing: border-box;
	}				
	</style>
}
