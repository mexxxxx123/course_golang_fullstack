package widgets

import "mexxx1/golang-fullstack/views/components"

templ VacancyForm() {
	@VacancyFormStyle()
	<div class="VacancyForm">
		<div class="VacancyForm_wrapper">
			<div id="vacancy-result"></div>
			<form hx-post="/vacancy" hx-trigger="submit" hx-target="#vacancy-result" hx-swap="innerHTML swap:1s">
				<div class="VacancyForm__titles">
					@components.Title1("Опубликовать вакансию")
					@components.SubTitle("Введите все необходимые данные для публикации")
				</div>
				<div class="VacancyForm__inputs">
					@components.Input(components.InputData{
						Name:        "role",
						Placeholder: "Должность",
					})
					@components.Input(components.InputData{
						Name:        "company-type",
						Placeholder: "Сфера Компании"})
					@components.Input(components.InputData{
						Name:        "location",
						Placeholder: "Расположение",
					})
					@components.Input(components.InputData{
						Name:        "company-name",
						Placeholder: "Название компании",
					})
					@components.Input(components.InputData{
						Name:        "salary",
						Placeholder: "Заработная плата",
					})
					@components.Input(components.InputData{
						Name:        "email",
						Placeholder: "Контактный email",
					})
				</div>
				<div class="VacancyForm-button">
					@components.ButtonForm("Опубликовать вакансию")
					<span class="VacancyForm-loader"></span>
				</div>
			</form>
		</div>
	</div>
}

templ VacancyFormStyle() {
	<style>
		.VacancyForm{
			display: flex;
			justify-content: center;
			padding: 60px 0 120px 0;
		    background: rgba(48, 150, 137, 0.1);;
		}
       .VacancyForm_wrapper{
			max-width:894px ;
			width: 100%;
       }    

		.VacancyForm__titles{
			display: flex;
			flex-direction: column;
			gap: 40px;
			margin-bottom: 60px;
		}

       .VacancyForm_wrapper form{ width: 100%; display: flex;
			align-items: center;
			justify-content: center;
			flex-direction: column;
       }    
	   #vacancy-result{
			width: 100%;
	   }
	   
  .htmx-request   .VacancyForm-button {
		display: none;
	}

	.htmx-request .VacancyForm-loader{
    	width: 48px;
	    height: 48px;
	    border: 5px solid #FFF;
	    border-bottom-color: #FF3D00;
 	   border-radius: 50%;
 	   display: inline-block;
 	   box-sizing: border-box;
 	   animation: rotation 1s linear infinite;
    }

    @keyframes rotation {
    0% {
        transform: rotate(0deg);
    }
    100% {
        transform: rotate(360deg);
    }
    } 


	   .VacancyForm__inputs{
			width: 100%;
			display: grid;
			grid-template-columns: repeat(2 , 1fr);
			row-gap: 30px;
			column-gap: 24px;
			align-items: center;
			justify-content: center;
			margin-bottom: 30px;
		
	   }
        
    </style>
}
